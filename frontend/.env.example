# Base URL of the CoreMeet API
VITE_API_BASE_URL=http://localhost:5099
# SignalR meeting hub (used from step 3)
VITE_HUB_URL=http://localhost:5099/hubs/meeting
# WebRTC ICE servers as a JSON array (optional; defaults to a public STUN server).
# Production example with a TURN server:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:coremeetapis.urapp4u.com:3478?transport=udp","turn:coremeetapis.urapp4u.com:3478?transport=tcp"],"username":"coremeet","credential":"REPLACE_ME"}]
